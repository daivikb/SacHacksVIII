rules_version = '2';

// Admin access is the `admin` attribute on users/{uid}. Only an explicit
// `true` counts. It is granted from the Firebase console or the Admin SDK
// (both bypass these rules) — no client can set it, including on itself.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('admin', false) == true;
    }

    // ---- users ----------------------------------------------------------
    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();

      // Sign-up (email and Google) writes admin: false and its own uid as user_id.
      allow create: if isSelf(uid)
        && request.resource.data.get('admin', false) == false
        && request.resource.data.user_id == uid;

      // Profile / email updates may touch any field except `admin` and `user_id`.
      allow update: if isSelf(uid)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['admin', 'user_id']);

      allow delete: if false;
    }

    // ---- admin workspace -------------------------------------------------
    // Participant-facing pages don't read or write these yet. When they do
    // (e.g. the application form submitting), add owner rules here.

    match /applications/{id} {
      allow read: if isAdmin();
      // Reviews may only change the review fields.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'reviewed_by', 'reviewed_at'])
        && request.resource.data.reviewed_by == request.auth.uid;
    }

    match /teams/{id} {
      allow read: if isAdmin();
    }

    match /demos/{id} {
      allow read: if isAdmin();
    }

    match /certifications/{id} {
      allow read: if isAdmin()
        || (signedIn() && resource.data.user_id == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.issued_by == request.auth.uid;
    }

    // Everything else is denied by default.
  }
}
